{
  "name": "united-foods-content",
  "version": "1.0.0",
  "private": true,
  "description": "UFC — United Foods Content: Recipe, Scaling & HPP Costing System",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
